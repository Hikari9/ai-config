{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{HOME}}/.codex/hooks/graft/graft-hooks.cjs\" post-edit || exit 0",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{HOME}}/.codex/hooks/graft/graft-hooks.cjs\" codex-post-bash || exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "rtk hook codex",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{HOME}}/.codex/hooks/graft/graft-hooks.cjs\" pre-bash || exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '{{HOME}}/.codex/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{HOME}}/.codex/hooks/graft/graft-hooks.cjs\" session-start || exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{HOME}}/.codex/hooks/graft/graft-hooks.cjs\" stop || exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{HOME}}/.codex/hooks/graft/graft-hooks.cjs\" prompt || exit 0",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
