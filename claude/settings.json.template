{
  "skillListingBudgetFraction": 0.004,
  "env": {
    "GRAFT_NO_STATUSLINE": "1",
    "TE_PYTHON": "{{HOME}}/.claude/hooks/te-python",
    "CLAUDE_CODE_EXPERIMENTAL_CODE_MODE": "1"
  },
  "permissions": {
    "allow": [
      "Agent",
      "Bash(agy:*)",
      "Bash(claude:*)",
      "Bash(codex exec:*)",
      "Bash(composio *)",
      "Bash(composio:*)",
      "Bash(curl:*)",
      "Bash(echo:*)",
      "Bash(ego-browser nodejs:*)",
      "Bash(gh issue close:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh:*)",
      "Bash(git:*)",
      "Bash(grep:*)",
      "Bash(herdr:*)",
      "Bash(office land *)",
      "Bash(office land)",
      "Bash(office:*)",
      "Bash(pnpm:*)",
      "Bash(python3:*)",
      "Bash(scp * rock.favor.church:*)",
      "Bash(sqlite3 ~/.local/share/auto-office/runs.db:*)",
      "Bash(ssh rock.favor.church *)",
      "Bash(turso:*)",
      "Bash(vercel:*)",
      "Read(~/.claude/*.md)",
      "Read(~/.claude/CLAUDE.md)",
      "Read(~/.claude/rules/**)",
      "Read(~/.claude/skills/**)",
      "Read(~/.codex/AGENTS.md)",
      "Read(~/.local/share/auto-office/**)",
      "Read(~/.local/state/auto-office/**)",
      "Read(~/AGENTS.md)",
      "Read(~/CLAUDE.md)",
      "SendMessage",
      "mcp__claude_ai_Vercel__get_runtime_logs",
      "mcp__plugin_context-mode_context-mode"
    ],
    "deny": [
      "Bash(curl *ApiKey*)",
      "Bash(curl *UserLogin*)",
      "Bash(declare -p)",
      "Bash(env)",
      "Bash(export -p)",
      "Bash(printenv)",
      "Bash(printenv:*)",
      "CronCreate",
      "CronDelete",
      "CronList",
      "DesignSync",
      "EnterPlanMode",
      "ExitPlanMode",
      "NotebookEdit",
      "Read(**/.env)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.local)",
      "Read(**/.env.preview)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(~/.env)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "skillOverrides": {
    "attendees": "user-invocable-only",
    "data-source-verify": "user-invocable-only",
    "design-like-favor": "user-invocable-only",
    "loop-me": "user-invocable-only",
    "macos-launchd-agents": "user-invocable-only",
    "migration-orchestrator": "user-invocable-only",
    "setup-ts-deep-modules": "user-invocable-only",
    "skill-corpus-audit": "user-invocable-only",
    "update-tech-dashboard-live-signups": "user-invocable-only",
    "mattpocock-skills:wizard": "user-invocable-only",
    "codex:codex-result-handling": "user-invocable-only",
    "codex:gpt-5-4-prompting": "user-invocable-only",
    "context-mode:ctx-index": "user-invocable-only",
    "context-mode:ctx-insight": "user-invocable-only",
    "context-mode:ctx-purge": "user-invocable-only",
    "context-mode:ctx-stats": "user-invocable-only",
    "context-mode:ctx-upgrade": "user-invocable-only"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/office\" hook session.start --harness claude --office-managed",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/context-mode-cache-heal.mjs\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/helpers/graft-hooks.cjs\" session-start || exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/office\" hook prompt.submit --harness claude --office-managed",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/helpers/graft-hooks.cjs\" prompt || exit 0",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|write_file|replace",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/office\" hook tool.pre --harness claude --office-managed",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "matcher": "Bash|Read|Grep|mcp__rock-mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/hook-gate.sh\" keyguard node \"$HOME/.claude/hooks/rock-key-guard.mjs\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/helpers/graft-hooks.cjs\" pre-edit || exit 0",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/helpers/graft-hooks.cjs\" pre-bash || exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/helpers/graft-hooks.cjs\" post-edit || exit 0",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|mcp__graft__|mcp__trail__|Read|Grep|Glob|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/helpers/graft-hooks.cjs\" tool-savings || exit 0",
            "timeout": 8
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/office\" hook turn.stop --harness claude --office-managed",
            "timeout": 86400,
            "asyncRewake": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/helpers/graft-hooks.cjs\" stop || exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/helpers/graft-hooks.cjs\" session-end || exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/helpers/graft-hooks.cjs\" post-bash-fail || exit 0",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "enableArtifact": false,
  "enableWorkflows": true,
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "sh \"$HOME/.claude/wherdr-statusline.sh\" 'input=$(cat); eval \"$(printf '\"'\"'%s'\"'\"' \"$input\" | /usr/bin/jq -r '\"'\"'def bar($p; $w): ([[$p,0]|max,100]|min) as $q | ($q/100*$w*8|round) as $e | ($e/8|floor) as $full | ($e%8) as $rem | ([\"\",\"▏\",\"▎\",\"▍\",\"▌\",\"▋\",\"▊\",\"▉\"][$rem]) as $part | ($w-$full-(if $rem>0 then 1 else 0 end)) as $empty | (if $q>=80 then \"\\u001b[38;5;210m\" elif $q>=50 then \"\\u001b[38;5;222m\" else \"\\u001b[38;5;114m\" end) + (reduce range(0;$full) as $i (\"\";.+\"█\")) + $part + \"\\u001b[2m\" + (reduce range(0;$empty) as $i (\"\";.+\"░\")) + \"\\u001b[0m\"; @sh \"cwd=\\(.workspace.current_dir // \"\")\", @sh \"cost=\\(if .cost.total_cost_usd != null then (\"$\" + ((.cost.total_cost_usd*100|round)/100|tostring)) else \"\" end)\", @sh \"line1=\\([ ((.model.display_name | split(\" (\")[0]) + (if .effort.level then \" (\" + .effort.level + \")\" else \"\" end)), (if .rate_limits.five_hour.used_percentage != null then ((.rate_limits.five_hour.used_percentage) as $p | (.rate_limits.five_hour.resets_at) as $r | \"5h \" + bar($p;8) + \" \" + ($p|round|tostring) + \"%\" + (if $r != null then (\" [\" + (($r|localtime|strftime(\"%I:%M%p\")) | sub(\"^0\";\"\") | ascii_downcase) + \"]\") else \"\" end)) else empty end), (if .rate_limits.seven_day.used_percentage != null then ((.rate_limits.seven_day.used_percentage) as $p | (.rate_limits.seven_day.resets_at) as $r | \"weekly \" + bar($p;8) + \" \" + ($p|round|tostring) + \"%\" + (if $r != null then (\" [\" + (($r|localtime|strftime(\"%a %I:%M%p\")) | sub(\" 0\";\" \") | ascii_downcase) + \"]\") else \"\" end)) else empty end) ] | map(select(. != null and . != \"\")) | join(\" · \"))\", @sh \"ctxline=\\(if .context_window.total_input_tokens != null then (\"ctx: \" + ((.context_window.total_input_tokens/1000)|round|tostring) + \"k \" + bar((.context_window.used_percentage // 0);8) + \" [\" + ((.workspace.current_dir // \"\") | split(\"/\")[-1]) + \"]\") else \"\" end)\"'\"'\"')\"; dpath=\"$cwd\"; case \"$cwd\" in \"$HOME\") dpath=\"~\" ;; \"$HOME\"/*) dpath=\"~${cwd#$HOME}\" ;; esac; line2=\"$dpath\"; if [ -n \"$cwd\" ] && gitinfo=$(git --no-optional-locks -C \"$cwd\" rev-parse --git-dir --git-common-dir --show-toplevel --abbrev-ref HEAD --short HEAD 2>/dev/null); then { IFS= read -r gitdir; IFS= read -r commondir; IFS= read -r top; IFS= read -r branch; IFS= read -r sha; } <<EOF\n$gitinfo\nEOF\n[ \"$branch\" = \"HEAD\" ] && branch=\"$sha\"; line2=\"$dpath | $branch\"; if [ \"$gitdir\" != \"$commondir\" ]; then line2=\"$line2 : ${top##*/}\"; fi; fi; printf '\"'\"'%s\\n'\"'\"' \"$line1\"; acct=$(/usr/bin/jq -r '\"'\"'.oauthAccount.emailAddress // empty'\"'\"' \"$HOME/.claude.json\" 2>/dev/null); if [ -n \"$acct\" ]; then line2=\"$acct · $line2\"; fi; printf '\"'\"'%s\\n'\"'\"' \"$line2\"; line3=\"$ctxline\"; if [ -n \"$cost\" ]; then if [ -n \"$line3\" ]; then line3=\"$line3 · $cost\"; else line3=\"$cost\"; fi; fi; if [ -n \"$line3\" ]; then printf '\"'\"'%s\\n'\"'\"' \"$line3\"; fi'"
  },
